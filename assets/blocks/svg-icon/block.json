{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "functionalities/svg-icon-block",
	"version": "1.5.0",
	"title": "SVG Icon",
	"category": "design",
	"icon": "flag",
	"description": "Insert an SVG icon from your Functionalities library.",
	"textdomain": "functionalities",
	"attributes": {
		"iconSource": {
			"type": "string",
			"default": "custom"
		},
		"iconSlug": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"coreIcon": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"size": {
			"type": "number",
			"default": 48
		},
		"sizeUnit": {
			"type": "string",
			"default": "px"
		},
		"align": {
			"type": "string",
			"default": "none"
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"colorMode": {
			"type": "string",
			"default": "monochrome"
		},
		"decorative": {
			"type": "boolean",
			"default": true
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true,
		"align": [
			"left",
			"center",
			"right"
		],
		"color": {
			"text": true,
			"background": true,
			"gradients": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"dimensions": {
			"minHeight": false
		}
	}
}
