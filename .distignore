# Development. Leading slashes anchor these to the plugin root so a bundled
# path such as assets/vendor/ is not swept up with Composer's vendor/.
/.git
/.github
/.gitignore
/.distignore
/node_modules
/vendor
/tests
/coverage
/src
/docs

# Config
.editorconfig
.eslintrc.js
.prettierrc
phpunit.xml*
phpcs.xml*
phpstan.neon

# Build tools
/build.sh
/package.json
/package-lock.json
/composer.json
/composer.lock

# IDE
.idea/
.vscode/
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Claude Code
CLAUDE.md
.claude/

# Patterns
*.md
*.log
*.zip
*.swp
*.swo
*~

# Misc
/build-release/
/.wordpress-org/
/landing-page.html
/LICENSE
